# Copy this file to .env and fill in your values.

# --- Gemini LLM ---
GEMINI_API_KEY=api_key_here
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=1024

# --- Embeddings ---
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# --- RAG tuning ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5

# --- Conversation memory ---
MAX_MEMORY_TURNS=6

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=8501

# --- Logging ---
LOG_LEVEL=INFO
